# Copy to .env and adjust. NEVER commit real secrets.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://casino:casino@localhost:5432/casino
# Optional: enables cross-instance broadcast (presence, big wins)
REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Comma-separated origins allowed to call the API (web, capacitor, electron)
CORS_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost,app://casino
# Usernames that receive the super_admin role on login (comma-separated)
ADMIN_USERNAMES=
# Public URL of the web client; used for links in verification / reset emails
APP_URL=http://localhost:5173
# SMTP connection for outgoing mail, e.g. smtps://user:pass@smtp.example.com:465
# Without it, mail stays queued in the email_outbox table and nothing is sent.
SMTP_URL=
MAIL_FROM=Keyo Game <no-reply@keyo.game>
