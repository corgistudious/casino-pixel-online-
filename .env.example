# Copy to .env and adjust. NEVER commit real secrets.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://casino:casino@localhost:5432/casino
# Optional: enables cross-instance broadcast (presence, big wins)
REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Comma-separated origins allowed to call the API (web, capacitor, electron)
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost,app://.
