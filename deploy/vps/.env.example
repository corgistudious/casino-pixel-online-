# Keyo Game — shared VPS configuration.
# Copy to /opt/keyo-game/deploy/vps/.env, fill in real values, then: chmod 600 .env
# NEVER commit the real .env. Generate secrets with: openssl rand -hex 32

# --- Data mode -------------------------------------------------------------
# test        : test phase. Every new account is a TEST account (deleted by reset:test-data).
# production  : only after `launch:production` has run on this database.
# The server refuses to start if this does not match the database.
KEYO_DATA_MODE=test

# --- Public address ----------------------------------------------------------
# Domain served by the host reverse proxy (nginx/Caddy) with HTTPS.
APP_URL=https://play.example.com
CORS_ORIGINS=https://play.example.com,capacitor://localhost,https://localhost,app://casino

# Host port for the host reverse proxy, bound to 127.0.0.1 only. Pick one that is free
# (check with: ss -ltnp | grep :18480). Must not collide with other apps on the VPS.
KEYO_HTTP_PORT=18480

# --- Secrets -----------------------------------------------------------------
POSTGRES_DB=keyo_game
POSTGRES_PASSWORD=
JWT_SECRET=

# --- Accounts & mail -----------------------------------------------------------
# Usernames that receive super_admin on login (comma-separated).
ADMIN_USERNAMES=
# Without SMTP_URL, emails stay queued in the database and are not sent.
SMTP_URL=
MAIL_FROM=Keyo Game <no-reply@keyo.game>

# --- Redis namespace -------------------------------------------------------------
# Every Redis key/channel starts with this prefix (Keyo also runs its own Redis container).
REDIS_PREFIX=keyo:

# --- Operations --------------------------------------------------------------------
LOG_LEVEL=info
KEYO_IMAGE_TAG=local
BACKUP_RETENTION_DAYS=14
# Only for `create-test-accounts` in test mode; leave empty otherwise.
KEYO_TEST_ACCOUNT_PASSWORD=
