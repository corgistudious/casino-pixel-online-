{
  "name": "casino-pixel-online",
  "private": true,
  "version": "0.1.0",
  "description": "Keyo Game — premium 2D HD multiplayer social casino (virtual currency only)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @casino/server --filter @casino/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @casino/server db:migrate",
    "reset:test-data": "pnpm --filter @casino/server reset:test-data",
    "launch:production": "pnpm --filter @casino/server launch:production"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  }
}
